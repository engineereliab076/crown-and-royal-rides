# Example environment configuration for Crown and Royal Rides.
#
# Copy this file to `.env.local` (or `.env`) and fill in values as needed:
#   cp .env.example .env.local
#
# Never commit `.env` or `.env.local`; they are git-ignored. Only this example
# file is committed, and it must never contain real secrets or tokens.
#
# Notes that the environment validation enforces:
#   - Optional provider groups left blank stay disabled. If you set ANY value in
#     an all-or-none group, the entire group becomes required.
#   - Preview and production app URLs must use HTTPS.
#   - Preview/production Cloudinary folder, rate-limit namespace, and Sentry
#     environment values must match the deployment environment.
#   - Seed credentials must never be set in production.
#   - AUTH_SECRET, IP_HASH_SECRET, and CRON_SECRET must each be independently
#     generated (at least 32 chars) and must not be reused across each other.

# ── 1. Application ───────────────────────────────────────────────────────────
NODE_ENV=development
# Leave blank locally; Vercel sets this to preview/production automatically.
VERCEL_ENV=
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# ── 2. Database ──────────────────────────────────────────────────────────────
# Matches the local Docker Compose PostgreSQL service (compose.yaml). These are
# local development credentials only, not real deployment secrets. If you set
# POSTGRES_PORT to override the host port, update both URLs below to match.
DATABASE_URL=postgresql://crown_royal_rides:crown_royal_rides_dev@localhost:5432/crown_royal_rides?schema=public
DIRECT_DATABASE_URL=postgresql://crown_royal_rides:crown_royal_rides_dev@localhost:5432/crown_royal_rides?schema=public

# ── 3. Authentication and security ───────────────────────────────────────────
# Auth is validated as an all-or-none group. Leave both blank until real auth is
# configured; setting only one would fail validation. Generate independently.
AUTH_SECRET=
AUTH_URL=
# Independently generated secret (min 32 chars); must differ from AUTH_SECRET.
IP_HASH_SECRET=

# ── 4. Cloudinary ────────────────────────────────────────────────────────────
# All-or-none group. Folder prefix must match the environment (dev/preview/prod).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=

# ── 5. Resend / email ────────────────────────────────────────────────────────
# All-or-none group.
RESEND_API_KEY=
EMAIL_FROM=
INQUIRY_NOTIFICATION_FALLBACK=

# ── 6. Upstash rate limiting ─────────────────────────────────────────────────
# All-or-none group. Namespace must match the environment (dev:/preview:/prod:).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_NAMESPACE=

# ── 7. Cron ──────────────────────────────────────────────────────────────────
# Independently generated secret (min 32 chars); must differ from the others.
CRON_SECRET=

# ── 8. Sentry ────────────────────────────────────────────────────────────────
# SENTRY_DSN, NEXT_PUBLIC_SENTRY_DSN, and SENTRY_ENVIRONMENT are an all-or-none
# group; SENTRY_AUTH_TOKEN is standalone. Never put a real secret on any
# NEXT_PUBLIC_ variable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_AUTH_TOKEN=

# ── 9. One-time first-owner seed ──────────────────────────────────────────────
# Seed credentials are supplied only for the command and never persisted here.
# Leave both controls blank for local/test seeding. Production requires
# SEED_TARGET=production and the exact documented non-secret acknowledgement.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_TARGET=
ALLOW_PRODUCTION_FIRST_OWNER_SEED=
